# Copy to .env and fill in. .env is gitignored. Never put secrets in client (app/) code:
# anything prefixed VITE_ is shipped to the browser.

# --- ML precompute (Sentinel-2, CHIRPS, iSDAsoil via Google Earth Engine) ---
EE_PROJECT=
# Path to a service-account JSON key stored OUTSIDE the repo
EE_SERVICE_ACCOUNT_KEY_PATH=

# NASA POWER needs no key.

# --- Phrase audio (build-time only; clips are committed, the key is not) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_SW=
ELEVENLABS_VOICE_ID_EN=

# --- Report signing (backend only). ES256 = ECDSA P-256 + SHA-256, PKCS#8 PEM, base64-encoded ---
REPORT_SIGNING_PRIVATE_KEY_B64=
REPORT_SIGNING_KEY_ID=backend-demo-2026-10

# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY= # backend only, never in app/ (bypasses row-level security)
# Safe in the browser: the anon key is public by design; row-level security protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Public URLs (safe to expose) ---
VITE_PUBLIC_BASE_URL=https://agrifarm-evidence.vercel.app
VITE_SIGNING_PUBLIC_KEY_JWK=
