  },
  "sw/AREA_SAID": {
    "sha": "eeb79834141d8c37",
    "text": "Ulisema shamba lako lina",
    "model": "eleven_v4",
    "voice": "i5oE89JoUCpIgvSOemWx"
  },
  "sw/CONSENT_ASK": {
    "sha": "4fcb9a3fdd5eb1d8",
    "text": "Je, unakubali? Gusa kitufe cha kijani kusema ndiyo, au kitufe chekundu kusema hapana.",
    "model": "eleven_v4",
    "voice": "i5oE89JoUCpIgvSOemWx"
  },
  "sw/CONSENT_DELETE": {
    "sha": "f3b1defa73031da7",
    "text": "Unaweza kufuta kila kitu wakati wowote.",
    "model": "eleven_v4",
    "voice": "i5oE89JoUCpIgvSOemWx"
  },
  "sw/CONSENT_DECLINED": {
    "sha": "a27273de65fa7746",
    "text": "Sawa. Hakuna kilichorekodiwa.",
    "model": "eleven_v4",
    "voice": "i5oE89JoUCpIgvSOemWx"
  },
  "sw/CONSENT_PRIVACY": {
    "sha": "bf08d71e26caff74",
    "text": "Hakuna kitakachotoka kwenye simu hii bila idhini yako. Rekodi ya sauti yako inabaki kwenye simu hii.",
    "model": "eleven_v4",
    "voice": "i5oE89JoUCpIgvSOemWx"
  },
  "sw/CONSENT_INTRO": {
    "sha": "ed3e113a3c6e165f",
    "text": "Programu hii inakusaidia kuandaa ripoti ya ushahidi kuhusu shamba lako. Inarekodi sauti yako, picha, na mahali shamba lako lilipo.",
    "model": "eleven_v4",
    "voice": "i5oE89JoUCpIgvSOemWx"
  },
  "sw/CAPTURE_CONFIRM": {
    "sha": "7dd0f801de64a70b",
    "text": "Je, hii ni sahihi? Gusa ndiyo au hapana.",
    "model": "eleven_v4",
    "voice": "i5oE89JoUCpIgvSOemWx"
  },
  "sw/CAPTURE_WALK": {
    "sha": "11fc4b208cf26891",
    "text": "Tembea kando ya mpaka wa shamba lako. Simu itachora mpaka huo.",
    "model": "eleven_v4",
    "voice": "i5oE89JoUCpIgvSOemWx"
  },
  "sw/CAPTURE_DRAW": {
    "sha": "0dd339989bfab640",
    "text": "Au chora mpaka wa shamba lako kwenye ramani kwa kidole chako.",
    "model": "eleven_v4",
    "voice": "i5oE89JoUCpIgvSOemWx"
  },
  "sw/CAPTURE_SPEAK": {
    "sha": "6698ecf1ec4f4d0f",
    "text": "Tueleze kuhusu shamba lako: unalima nini, lina ukubwa gani, umekuwa mwanachama wa chama cha ushirika kwa muda gani, na misimu yoyote mibaya.",
    "model": "eleven_v4",
    "voice": "i5oE89JoUCpIgvSOemWx"
  },
  "sw/CAPTURE_PHOTO": {
    "sha": "ab04ed3ae58eca35",
    "text": "Simama ndani ya shamba lako na upige picha ya mazao yako.",
    "model": "eleven_v4",
    "voice": "i5oE89JoUCpIgvSOemWx"
  },
  "sw/CAPTURE_TURN": {
    "sha": "9396a4b5a6512c21",
    "text": "Sasa geuka nyuma upige picha moja zaidi.",
    "model": "eleven_v4",
    "voice": "i5oE89JoUCpIgvSOemWx"
  },
  "sw/CAPTURE_OUTSIDE": {
    "sha": "d7f49e8ca5cc88b1",
    "text": "Picha hii iko nje ya mpaka wa shamba lako. Tafadhali ingia ndani ya shamba ujaribu tena.",
    "model": "eleven_v4",
    "voice": "i5oE89JoUCpIgvSOemWx"
  },
  "sw/CAPTURE_DONE": {
    "sha": "b2307bb65e18dc18",
    "text": "Asante. Ripoti yako inaandaliwa kwenye simu hii.",
    "model": "eleven_v4",
    "voice": "i5oE89JoUCpIgvSOemWx"
  },
  "sw/CAPTURE_NO_GPS": {
    "sha": "f7a152f4e5d7e78e",
    "text": "Simu haiwezi kupata mahali ilipo. Nenda mahali pa wazi na usubiri kidogo.",
    "model": "eleven_v4",
    "voice": "i5oE89JoUCpIgvSOemWx"
  },
  "sw/RESULT_COOP": {
    "sha": "0442c65b24f11b6c",
    "text": "Chama chako cha ushirika kimethibitisha hili.",
    "model": "eleven_v4",
    "voice": "i5oE89JoUCpIgvSOemWx"
  },
  "sw/RESULT_MACHINE": {
    "sha": "ab5aeae08733f1ed",
    "text": "Kumbukumbu za satelaiti au hali ya hewa zinakubaliana na hili.",
    "model": "eleven_v4",
    "voice": "i5oE89JoUCpIgvSOemWx"
  },
  "sw/REVIEW_INTRO": {
    "sha": "038fbb9329568823",
    "text": "Hii ni ripoti yako ya ushahidi. Isikilize, kisha uamue kama unataka kuishiriki.",
    "model": "eleven_v4",
    "voice": "i5oE89JoUCpIgvSOemWx"
  },
  "sw/RESULT_OFFICER": {
    "sha": "6ddd1c338c66433f",
    "text": "Afisa ugani wako amethibitisha hili.",
    "model": "eleven_v4",
    "voice": "i5oE89JoUCpIgvSOemWx"
  },
  "sw/CROP_SAID_COFFEE": {
    "sha": "ce5d4f3c02193687",
    "text": "Ulisema unalima kahawa.",
    "model": "eleven_v4",
    "voice": "i5oE89JoUCpIgvSOemWx"
  },
  "sw/RESULT_CONTRADICTED": {
    "sha": "a802616f1c891d73",
    "text": "Kumbukumbu hazikubaliani na hili. Afisa mikopo anaweza kukuuliza kuhusu hili.",
    "model": "eleven_v4",
    "voice": "i5oE89JoUCpIgvSOemWx"
  },
  "sw/RESULT_UNVERIFIABLE": {
    "sha": "d2d6b88ad7a8e6e8",
    "text": "Hili halikuweza kukaguliwa. Linabaki kuwa maelezo yako mwenyewe.",
    "model": "eleven_v4",
    "voice": "i5oE89JoUCpIgvSOemWx"
  },
  "sw/CROP_SAID_MAIZE": {
    "sha": "6de1a2b3fe80919b",
    "text": "Ulisema unalima mahindi.",
    "model": "eleven_v4",
    "voice": "i5oE89JoUCpIgvSOemWx"
  },
  "sw/CROP_SAID_COFFEE_BANANA": {
    "sha": "85703f8f15c2367e",
    "text": "Ulisema unalima kahawa pamoja na migomba.",
    "model": "eleven_v4",
    "voice": "i5oE89JoUCpIgvSOemWx"
  },
  "sw/CROP_SAT_COFFEE": {
    "sha": "3b0e3e52a7d29998",
    "text": "Picha za satelaiti za shamba lako zinaonekana kama kahawa, ambayo hubaki kijani mwaka mzima.",
    "model": "eleven_v4",
    "voice": "i5oE89JoUCpIgvSOemWx"
  },
  "sw/CROP_SAT_SEASONAL": {
    "sha": "0fd46088cd72933b",
    "text": "Picha za satelaiti za shamba lako zinaonekana kama zao la msimu kama mahindi, si kahawa.",
    "model": "eleven_v4",
    "voice": "i5oE89JoUCpIgvSOemWx"
  },
  "sw/CROP_SAT_UNSURE": {
    "sha": "8d412373164504df",
    "text": "Picha za satelaiti hazionyeshi wazi zao lililopo shambani kwako.",
    "model": "eleven_v4",
    "voice": "i5oE89JoUCpIgvSOemWx"
  },
  "sw/PHOTO_COFFEE": {
    "sha": "900dfa04b0c5ba12",
    "text": "Picha zako zinaonekana kuonyesha mimea ya kahawa.",
    "model": "eleven_v4",
    "voice": "i5oE89JoUCpIgvSOemWx"
  },
  "sw/PHOTO_NOT_COFFEE": {
    "sha": "f63685381d1f2d43",
    "text": "Picha zako hazionekani kuonyesha mimea ya kahawa.",
    "model": "eleven_v4",
    "voice": "i5oE89JoUCpIgvSOemWx"
  },
  "sw/PHOTO_INSIDE": {
    "sha": "f4c0be36a45fe5e0",
    "text": "Picha zako zote zilipigwa ndani ya shamba lako.",
    "model": "eleven_v4",
    "voice": "i5oE89JoUCpIgvSOemWx"
  },
  "sw/AREA_MAP": {
    "sha": "ac5949701f63cb94",
    "text": "Shamba ulilochora kwenye ramani lina takriban",
    "model": "eleven_v4",
    "voice": "i5oE89JoUCpIgvSOemWx"
  },
  "sw/PHOTO_DUPLICATE": {
    "sha": "aea7c21db9d60ffa",
    "text": "Picha moja inafanana na picha iliyo kwenye ripoti nyingine. Mtu atakagua hili.",
    "model": "eleven_v4",
    "voice": "i5oE89JoUCpIgvSOemWx"
  },
  "sw/SEASON_SAID": {
    "sha": "58a75ccd88410db7",
    "text": "Ulisema msimu mbaya ulikuwa mwaka",
    "model": "eleven_v4",
    "voice": "i5oE89JoUCpIgvSOemWx"
  },
  "sw/HEAT_HIGH": {
    "sha": "25983d5ef046dafb",
    "text": "Msimu huo pia ulikuwa na joto kuliko kawaida.",
    "model": "eleven_v4",
    "voice": "i5oE89JoUCpIgvSOemWx"
  },
  "sw/RAIN_DRY": {
    "sha": "fcd85710c907ffff",
    "text": "Kumbukumbu za mvua zinaonyesha msimu huo ulikuwa na mvua chache kuliko kawaida, kwa takriban asilimia",
    "model": "eleven_v4",
    "voice": "i5oE89JoUCpIgvSOemWx"
  },
  "sw/COOP_SAID": {
    "sha": "177f3cb6298b6754",
    "text": "Ulisema umekuwa mwanachama wa chama cha ushirika kwa miaka",
    "model": "eleven_v4",
    "voice": "i5oE89JoUCpIgvSOemWx"
  },
  "sw/COOP_SAID_ONE": {
    "sha": "503139a11bc0c9b6",
    "text": "Ulisema umekuwa mwanachama wa chama cha ushirika kwa mwaka mmoja.",
    "model": "eleven_v4",
    "voice": "i5oE89JoUCpIgvSOemWx"
  },
  "sw/RAIN_NORMAL": {
    "sha": "75351610995b1f57",
    "text": "Mvua zilikuwa za kawaida msimu huo, kwa hiyo sababu inaweza kuwa nyingine, kama wadudu, magonjwa au udongo. Afisa ugani anaweza kukusaidia kujua sababu.",
    "model": "eleven_v4",
    "voice": "i5oE89JoUCpIgvSOemWx"
  },
  "sw/HARVEST_SAID": {
    "sha": "d45f8d7c965a627d",
    "text": "Ulituambia kiasi cha kahawa ulichowasilisha msimu uliopita.",
    "model": "eleven_v4",
    "voice": "i5oE89JoUCpIgvSOemWx"
  },
  "sw/OWNERSHIP_NOT_SHOWN": {
    "sha": "fdc7b1b1a8a420f0",
    "text": "Ripoti hii haionyeshi nani anamiliki ardhi hii.",
    "model": "eleven_v4",
    "voice": "i5oE89JoUCpIgvSOemWx"
  },
  "sw/OWNERSHIP_HOW": {
    "sha": "051b08cddc9d833c",
    "text": "Ili kuonyesha hili, chama chako kinaweza kusaini, au unaweza kuongeza hati ya ardhi.",
    "model": "eleven_v4",
    "voice": "i5oE89JoUCpIgvSOemWx"
  },
  "sw/SOIL_ACIDIC": {
    "sha": "b4612cfdede95fda",
    "text": "Ramani za udongo zinaonyesha kwamba udongo wako unaweza kuwa na tindikali. Haya ni makadirio tu. Muulize afisa ugani kabla ya kununua chochote.",
    "model": "eleven_v4",
    "voice": "i5oE89JoUCpIgvSOemWx"
  },
  "sw/NOT_SURE": {
    "sha": "758080c5aefd1e47",
    "text": "Hatuna uhakika kuhusu baadhi ya sehemu za ripoti hii. Tafadhali zungumza na afisa ugani au chama chako kabla ya kuishiriki.",
    "model": "eleven_v4",
    "voice": "i5oE89JoUCpIgvSOemWx"
  },
  "sw/DISCLAIMER": {
    "sha": "2bee2913406b52b5",
    "text": "Ripoti hii ni ushahidi, si hakikisho. Haikubali wala haikatai mkopo. Mtu ndiye atakayeamua.",
    "model": "eleven_v4",
    "voice": "i5oE89JoUCpIgvSOemWx"
  },
  "sw/SITE_VISIT": {
    "sha": "b6b9fba2644b8896",
